# Data — everything under data/ is generated (the JSONL/GZ exports pulled by
# `--fetch`) and must NOT be committed, EXCEPT the static store-concepts CSV.
# That file is not in the GCS export and IS required by the --stores step
# (it gets baked into the Docker image). See README "Store concepts".
data/*
!data/Evénement X Concept - Concept X Magasin.csv
data_samples/

# Generated reports (scripts/missing_portions.py writes here by default)
missing_portions.json

# Env
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
